{
  "manifest_version": 3,
  "name": "BFLIX Stream Catcher & M3U8 to MP4 Downloader",
  "version": "1.0.2",
  "description": "Automatically catches .m3u8 and video stream sources from web players and converts/downloads them to MP4 files.",
  "permissions": [
    "webRequest",
    "webNavigation",
    "tabs",
    "storage",
    "downloads",
    "activeTab",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ad_rules",
        "enabled": true,
        "path": "ad-rules.json"
      }
    ]
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  },
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  }
}
